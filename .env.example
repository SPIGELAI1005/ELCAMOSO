# ELCAMOSO environment variables
# Copy to .env.local for local development. Never commit secrets.

# --- Deployment tier (controls which Tesla OAuth app is used) ---
# development | staging | production
ELCAMOSO_ENV=development

# --- Optional AI (Settings / Studio) ---
OPENAI_API_KEY=

# --- Tesla Fleet OAuth (server-only — never expose to the browser) ---
# Register apps at https://developer.tesla.com (separate apps per environment recommended).
# Redirect URI must exactly match the value registered on developer.tesla.com.

# Development
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:5173/auth/tesla/callback

# Staging (optional — falls back to unprefixed vars when unset)
TESLA_CLIENT_ID_STAGING=
TESLA_CLIENT_SECRET_STAGING=
TESLA_REDIRECT_URI_STAGING=

# Production (optional — falls back to unprefixed vars when unset)
TESLA_CLIENT_ID_PRODUCTION=
TESLA_CLIENT_SECRET_PRODUCTION=
TESLA_REDIRECT_URI_PRODUCTION=

# Registered developer domain for virtual key pairing links (no protocol)
TESLA_DEVELOPER_DOMAIN=example.com

# Default Fleet API region before user region is resolved (NA | EU | CN)
TESLA_FLEET_REGION=NA

# 64-char hex (32 bytes) for AES-256-GCM encryption of refresh tokens at rest
TESLA_TOKEN_ENCRYPTION_KEY=

# Override token endpoint (default: https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token)
# TESLA_AUTH_TOKEN_URL=

# Allow read-only vehicle_data poll when Fleet Telemetry stream is not connected (default: on)
# Set to 0 in production once a Fleet Telemetry server forwards decoded fields.
# TESLA_VEHICLE_DATA_POLL=1

# --- Google account OAuth (server-only — never expose to the browser) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI must match exactly.
# https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/account/google/callback
# Production (required when ELCAMOSO_ENV=production and Google is configured):
# GOOGLE_REDIRECT_URI=https://www.elcamoso.com/auth/account/google/callback
# Optional dedicated HMAC secret for signed account session cookies (falls back to GOOGLE_CLIENT_SECRET):
# ELCAMOSO_ACCOUNT_SESSION_SECRET=

# Staging / production overrides (optional — same pattern as Tesla)
# GOOGLE_CLIENT_ID_STAGING=
# GOOGLE_CLIENT_SECRET_STAGING=
# GOOGLE_REDIRECT_URI_STAGING=
# GOOGLE_CLIENT_ID_PRODUCTION=
# GOOGLE_CLIENT_SECRET_PRODUCTION=
# GOOGLE_REDIRECT_URI_PRODUCTION=https://www.elcamoso.com/auth/account/google/callback

# --- Development database ---
# Zero-config local dev (PGlite): leave unset or use idb://elcamoso-dev
# DATABASE_URL=idb://elcamoso-dev
# Docker Postgres: docker compose up -d
# DATABASE_URL=postgresql://elcamoso:elcamoso_dev@localhost:5432/elcamoso_dev

# --- Stripe billing (server-only — never expose to the browser) ---
# Create recurring Prices in Stripe Dashboard; map them here by internal plan id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DRIVE_PLUS_MONTHLY=
STRIPE_PRICE_DRIVE_PLUS_YEARLY=

# Optional per-environment overrides (same pattern as TESLA_*_STAGING / _PRODUCTION)
# STRIPE_SECRET_KEY_STAGING=
# STRIPE_WEBHOOK_SECRET_STAGING=
# STRIPE_PRICE_DRIVE_PLUS_MONTHLY_STAGING=
# STRIPE_PRICE_DRIVE_PLUS_YEARLY_STAGING=
# STRIPE_SECRET_KEY_PRODUCTION=
# STRIPE_WEBHOOK_SECRET_PRODUCTION=
# STRIPE_PRICE_DRIVE_PLUS_MONTHLY_PRODUCTION=
# STRIPE_PRICE_DRIVE_PLUS_YEARLY_PRODUCTION=

# Drive+ access: days to retain entitlements after past_due (default 7)
# DRIVE_PLUS_PAST_DUE_GRACE_DAYS=7

# Master switch for checkout, upgrades, trials, and purchase UX. Keep false until production verification.
# MONETIZATION_ENABLED=0

# Comma-separated absolute origins allowed for Stripe checkout return URLs (production required)
# ELCAMOSO_ALLOWED_ORIGINS=https://app.elcamoso.com,http://localhost:5173

# Dev-only billing admin (/debug/billing, npm run billing:diagnostics)
# ELCAMOSO_BILLING_ADMIN_SECRET=

# HMAC secret for signed premium sound asset delivery URLs (server-only)
# SOUND_ASSET_SIGNING_SECRET=
