# ELCAMOSO environment variables
# Copy to .env.local for local development. Never commit secrets.

# --- Deployment tier (controls which Tesla OAuth app is used) ---
# development | staging | production
ELCAMOSO_ENV=development

# --- Optional AI (Settings / Studio) ---
OPENAI_API_KEY=

# --- Tesla Fleet OAuth (server-only — never expose to the browser) ---
# Register apps at https://developer.tesla.com (separate apps per environment recommended).
# Redirect URI must exactly match the value registered on developer.tesla.com.

# Development
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:5173/auth/tesla/callback

# Staging (optional — falls back to unprefixed vars when unset)
TESLA_CLIENT_ID_STAGING=
TESLA_CLIENT_SECRET_STAGING=
TESLA_REDIRECT_URI_STAGING=

# Production (optional — falls back to unprefixed vars when unset)
TESLA_CLIENT_ID_PRODUCTION=
TESLA_CLIENT_SECRET_PRODUCTION=
TESLA_REDIRECT_URI_PRODUCTION=

# Registered developer domain for virtual key pairing links (no protocol)
TESLA_DEVELOPER_DOMAIN=example.com

# Default Fleet API region before user region is resolved (NA | EU | CN)
TESLA_FLEET_REGION=NA

# 64-char hex (32 bytes) for AES-256-GCM encryption of refresh tokens at rest
TESLA_TOKEN_ENCRYPTION_KEY=

# Override token endpoint (default: https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token)
# TESLA_AUTH_TOKEN_URL=

# Allow read-only vehicle_data poll when Fleet Telemetry stream is not connected (default: on)
# Set to 0 in production once a Fleet Telemetry server forwards decoded fields.
# TESLA_VEHICLE_DATA_POLL=1

# --- Google account OAuth (server-only — never expose to the browser) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI must match exactly.
# https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/account/google/callback
# Production (required when ELCAMOSO_ENV=production and Google is configured):
# GOOGLE_REDIRECT_URI=https://www.elcamoso.com/auth/account/google/callback
# Optional dedicated HMAC secret for signed account session cookies (falls back to GOOGLE_CLIENT_SECRET):
# ELCAMOSO_ACCOUNT_SESSION_SECRET=

# Staging / production overrides (optional — same pattern as Tesla)
# GOOGLE_CLIENT_ID_STAGING=
# GOOGLE_CLIENT_SECRET_STAGING=
# GOOGLE_REDIRECT_URI_STAGING=
# GOOGLE_CLIENT_ID_PRODUCTION=
# GOOGLE_CLIENT_SECRET_PRODUCTION=
# GOOGLE_REDIRECT_URI_PRODUCTION=https://www.elcamoso.com/auth/account/google/callback

# --- Supabase Auth email OTP (server-only — never expose service-role keys) ---
# Passwordless six-digit email codes. Setup: docs/account/EMAIL_OTP_SETUP.md
# Template must include {{ .Token }} (not only a magic link).
# OTP expiry is configured in the Supabase project (provider-wide for email links).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional alias:
# SUPABASE_PUBLISHABLE_KEY=
# Force off even when URL+key are set: ELCAMOSO_EMAIL_OTP_ENABLED=0
# ELCAMOSO_EMAIL_OTP_ENABLED=1

# --- Development database ---
# Zero-config local dev (PGlite): leave unset or use idb://elcamoso-dev
# DATABASE_URL=idb://elcamoso-dev
# Docker Postgres: docker compose up -d
# DATABASE_URL=postgresql://elcamoso:elcamoso_dev@localhost:5432/elcamoso_dev

# --- Stripe billing (server-only — never expose to the browser) ---
# Create recurring Prices in Stripe Dashboard; map them here by internal plan id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DRIVE_PLUS_MONTHLY=
STRIPE_PRICE_DRIVE_PLUS_YEARLY=
# One-time Drive+ Lifetime (€38.99) Price id - optional; lifetime button hidden when unset
STRIPE_PRICE_DRIVE_PLUS_LIFETIME=

# Optional per-environment overrides (same pattern as TESLA_*_STAGING / _PRODUCTION)
# STRIPE_SECRET_KEY_STAGING=
# STRIPE_WEBHOOK_SECRET_STAGING=
# STRIPE_PRICE_DRIVE_PLUS_MONTHLY_STAGING=
# STRIPE_PRICE_DRIVE_PLUS_YEARLY_STAGING=
# STRIPE_SECRET_KEY_PRODUCTION=
# STRIPE_WEBHOOK_SECRET_PRODUCTION=
# STRIPE_PRICE_DRIVE_PLUS_MONTHLY_PRODUCTION=
# STRIPE_PRICE_DRIVE_PLUS_YEARLY_PRODUCTION=
# STRIPE_PRICE_DRIVE_PLUS_LIFETIME_PRODUCTION=

# Drive+ access: days to retain entitlements after past_due (default 7)
# DRIVE_PLUS_PAST_DUE_GRACE_DAYS=7

# Master switch for checkout, upgrades, trials, and purchase UX. Keep false until production verification.
# MONETIZATION_ENABLED=0

# Monthly Sound Spin / rewards. Disabled by default until campaign configuration is complete.
# When off, /rewards shows an unavailable state and claim APIs reject. Campaign must also be enabled.
# ELCAMOSO_REWARDS_ENABLED=0

# Stripe reward-discount fulfilment (Prompt 13). Off until test-mode coupons are configured.
# Never create live coupons from the app. Operator creates duration=once percent coupons in Stripe TEST mode.
# ELCAMOSO_REWARD_DISCOUNTS_ENABLED=0
# STRIPE_REWARD_COUPON_PERCENT_15=coupon_...
# STRIPE_REWARD_COUPON_PERCENT_20=coupon_...
# Optional JSON map for additional percents: STRIPE_REWARD_COUPON_PERCENT_MAP={"10":"coupon_..."}
# ELCAMOSO_REWARD_DISCOUNT_FINALIZED_ALTERNATIVE=pending
# ELCAMOSO_REWARD_DISCOUNT_MIN_AMOUNT_CENTS=
# ELCAMOSO_REWARD_DISCOUNT_CURRENCIES=eur,usd


# Comma-separated absolute origins allowed for Stripe checkout return URLs (production required)
# ELCAMOSO_ALLOWED_ORIGINS=https://app.elcamoso.com,http://localhost:5173

# Dev-only billing admin (/debug/billing, npm run billing:diagnostics)
# ELCAMOSO_BILLING_ADMIN_SECRET=

# Deployed audio lab gate (/debug/audio-lab). Falls back to billing admin secret when unset.
# Local Vite DEV does not require this. Never rely on a hidden URL alone in production.
# ELCAMOSO_AUDIO_LAB_SECRET=

# HMAC secret for signed premium sound asset delivery URLs (server-only)
# SOUND_ASSET_SIGNING_SECRET=

# --- Motion Experiences ---
# Drive Symphony V1 defaults ON. Set to 0 to disable musical engine selection.
# SYMPHONY_ENABLED=1
# Fusion (Engine + Symphony) defaults ON.
# FUSION_ENABLED=1
# Worlds reactive engine defaults ON.
# WORLDS_ENGINE_ENABLED=1
# Drive Song / Drive Reel (Journey Composer) default ON.
# DRIVE_SONG_ENABLED=1
# DRIVE_REEL_ENABLED=1

# --- Virtual drivetrain (Prompt 03) ---
# When 1, new/missing settings default to the artistic City shift map
# (upshifts km/h [15,28,43,58,75] for suitable six-speeds). Off = legacy Road Feel default.
# Users can still pick City / Touring / Sport in Settings either way.
# VITE_CITY_SHIFT_PRESET=0
# ELCAMOSO_CITY_SHIFT_PRESET=0

# --- Raw mechanical combustion (Prompt 04) ---
# Opt-in Drive Audio V3. When 1, SoundEngine may use realismEngine "v3" for pilot
# profiles (american-muscle-v8, flat-six-sport). Default off — Current/V2 unchanged.
# VITE_DRIVE_AUDIO_V3=0
# ELCAMOSO_DRIVE_AUDIO_V3=0

# --- Combustion order bands (engine-sim contract) ---
# When 1, HybridCombustionSynth builds RPM-tracking resonators from profile
# supportRatios/supportWeights as crank orders. Default off keeps legacy
# ½ / 1 / 2 × firing-order bands (production timbre unchanged).
# VITE_COMBUSTION_PROFILE_ORDER_BANDS=0
# ELCAMOSO_COMBUSTION_PROFILE_ORDER_BANDS=0

# --- Combustion topology pilot (engine-sim adaptation) ---
# When 1, american-muscle-v8 and race-car use explicit cylinder firing schedules
# + collector routing + primary delays in the combustion worklet. Default off.
# VITE_COMBUSTION_TOPOLOGY_PILOT=0
# ELCAMOSO_COMBUSTION_TOPOLOGY_PILOT=0

# --- Drive relay (production phone ↔ Tesla WebSocket) ---
# Client-safe public origin for wss://…/api/drive-relay/ws (no secrets, no path).
# Leave unset for local Vite (same-origin plugin). Required for production Vercel.
# VITE_DRIVE_RELAY_PUBLIC_ORIGIN=https://relay.elcamoso.com
#
# Server-only: proxy create/claim/join to the dedicated relay process.
# DRIVE_RELAY_INTERNAL_URL=https://relay.elcamoso.com
# DRIVE_RELAY_INTERNAL_SECRET=
# DRIVE_RELAY_ALLOWED_ORIGINS=https://www.elcamoso.com,http://localhost:5173
# VITE_SEO_FORCE_NOINDEX=1
